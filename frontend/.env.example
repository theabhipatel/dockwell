# Frontend dev/preview settings. The browser app has no runtime secrets: it always talks to
# the API on its own origin (/api and /v1), which the Vite dev server proxies to the backend.

# Backend address used by the Vite dev/preview proxy.
API_PROXY_TARGET=http://127.0.0.1:31100

# Public site (landing page and docs), read at build time.
# Absolute public origin, used for canonical URLs, Open Graph tags and sitemap.xml.
VITE_SITE_URL=
# Google Search Console "HTML tag" verification: paste only the content="..." value.
VITE_GOOGLE_SITE_VERIFICATION=
# "true" shows the public-demo notices on the public site.
VITE_DEMO_MODE=false
