{
  "name": "dockwell-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/site/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "oxlint src",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "gen:api": "uv run --project ../backend python -m dockwell_api.openapi_export > openapi.json && openapi-typescript openapi.json --default-non-nullable false -o src/lib/api-schema.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "highlight.js": "^11.12.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.58.0",
    "openapi-fetch": "^0.17.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "recharts": "^3.8.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
