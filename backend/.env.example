# ---- DockWell API settings ----------------------------------------------------------
# Copy to .env and adjust (./scripts/dev.sh does this for you with random secrets).
# Every setting also works as a plain environment variable. Admin-editable settings
# (prices, free credit, limits, sign-up, maintenance...) live in the database instead.

# development | test | production  (production hides /api/docs and the OpenAPI schema)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Public origin of the web app (the browser's address). Used for email links, the CSRF
# Origin check, CORS, the Google OAuth redirect URI and the API base URL (<APP_URL>/v1).
APP_URL=http://localhost:31180
APP_NAME=DockWell

DATABASE_URL=postgresql+asyncpg://dockwell:dockwell@localhost:31432/dockwell
DATABASE_ECHO=false

# Long random strings. Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Encrypts provider API keys, the Hugging Face token and 2FA secrets in the database.
ENCRYPTION_KEY=change-me-to-another-long-random-string

# Set to true whenever the app is served over HTTPS (required in production).
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=7

# SMTP. Development uses Mailpit from docker-compose (web UI: http://localhost:31825).
SMTP_HOST=localhost
SMTP_PORT=31025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TLS=false
MAIL_FROM="DockWell <no-reply@dockwell.local>"
EMAIL_WORKER_ENABLED=true

# Google sign-in (optional). OAuth client of type "Web application" with the redirect URI
# <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

EMAIL_VERIFICATION_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=60
INVITATION_TTL_DAYS=7

# Rate limits on sign-in and email actions
SIGNIN_IP_LIMIT=30
SIGNIN_EMAIL_FAILURE_LIMIT=5
SIGNIN_WINDOW_MINUTES=15
EMAIL_ACTION_LIMIT=5
EMAIL_ACTION_WINDOW_MINUTES=30
TOKEN_SUBMIT_IP_LIMIT=30
MAX_AVATAR_BYTES=1000000

# Platform admins: these addresses become admins when they sign in (comma separated).
ADMIN_EMAILS=admin@dockwell.dev
# Development only: creates the first admin account above with this password.
SEED_ADMIN_PASSWORD=
# Development only: a default regular user account, created (or reset) on start.
SEED_USER_EMAIL=abhi@gmail.com
SEED_USER_PASSWORD=1234
SEED_USER_NAME=Abhi Patel

# Shows the "this is a demo" notices. Payments on the demo are Stripe test mode.
DEMO_MODE=false

# ---- Payments (Stripe) ------------------------------------------------------------------
# Test keys (sk_test_...) or live keys (sk_live_...). Switching is configuration only.
# Webhook endpoint: <APP_URL>/api/stripe/webhook with the events checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# checkout.session.expired, payment_intent.succeeded, payment_intent.payment_failed,
# charge.refunded. Locally: stripe listen --forward-to localhost:31100/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Inference ----------------------------------------------------------------------------
UPSTREAM_TIMEOUT_SECONDS=600
UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
DEFAULT_MAX_TOKENS=4096
RESERVATION_TTL_MINUTES=30
# Registers the local llama.cpp server (docker-compose) and its model on start-up.
BOOTSTRAP_LLAMACPP_URL=http://127.0.0.1:31800/v1
BOOTSTRAP_LLAMACPP_MODEL=qwen2.5-0.5b-instruct
# Self-hosted: registers the bundled vLLM engine (docker-compose.prod.yml, gpu profile).
BOOTSTRAP_VLLM_URL=
BOOTSTRAP_VLLM_MODEL=
BOOTSTRAP_VLLM_CONTEXT=8192
# Demo: registers Groq and offers these models (free keys at https://console.groq.com).
GROQ_API_KEY=
GROQ_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile

# ---- Engine manager (deploy models from the admin area) ---------------------------------
# docker: start vLLM / llama.cpp containers through the Docker socket. none: off.
ENGINE_MANAGER=docker
DOCKER_SOCKET=/var/run/docker.sock
# Docker network shared with the API (docker compose). Empty = publish on 127.0.0.1.
ENGINE_NETWORK=
ENGINE_PORT_RANGE_START=31810
ENGINE_HF_CACHE_VOLUME=dockwell_hf_cache
VLLM_IMAGE=vllm/vllm-openai:latest
LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server

# ---- Monitoring ---------------------------------------------------------------------------
PROMETHEUS_URL=
METRICS_TOKEN=

# ---- Serverless hosting (Vercel demo only) -------------------------------------------
# SERVERLESS=true          # no background loops; send email inline; no connection pool
# CRON_SECRET=             # enables GET /api/internal/cron (Bearer token)
# CLIENT_IP_HEADER=        # e.g. x-real-ip, only behind a proxy that always sets it

# ---- Production compose (docker-compose.prod.yml, read from .env.prod) ---------------
# POSTGRES_PASSWORD=          # required
# GRAFANA_PASSWORD=           # required (Grafana user "admin", http://127.0.0.1:31030)
# WEB_PORT=31080              # where nginx listens; put TLS in front of it
# DOCKER_GID=999              # group id of /var/run/docker.sock (stat -c %g /var/run/docker.sock)
# API_WORKERS=2
# VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct    # gpu profile: the model the bundled vLLM serves
# VLLM_GPU_COUNT=1
# VLLM_MAX_MODEL_LEN=8192
# VLLM_GPU_MEMORY_UTILIZATION=0.9
# HF_TOKEN=                   # for gated models in the bundled vLLM
# With the gpu profile, register the bundled engine:
#   BOOTSTRAP_VLLM_URL=http://vllm:8000/v1
#   BOOTSTRAP_VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct   (same as VLLM_MODEL)
#   BOOTSTRAP_LLAMACPP_URL=                         (empty)
# With the cpu profile:
#   BOOTSTRAP_LLAMACPP_URL=http://llamacpp:8080/v1
#   BOOTSTRAP_LLAMACPP_MODEL=qwen2.5-1.5b-instruct
