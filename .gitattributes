# Keep Unix line endings in the repo and in checkouts, even with Git for Windows' autocrlf:
# shell scripts and files mounted into Linux containers break with CRLF.
* text=auto eol=lf

# Windows-only launchers use CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
