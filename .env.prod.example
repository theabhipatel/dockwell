# DockWell production settings for self-hosting with Docker Compose.
#
#   cp .env.prod.example .env.prod
#   # fill in every "change-me" value below, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod --profile gpu up -d --build
#   # (CPU-only server: --profile cpu)
#
# Generate random values with:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# Keep comments on their own lines (not after a value). Back up this file: ENCRYPTION_KEY cannot
# be recovered. Every setting is explained in the docs: /docs/configuration.

# ---- Required -------------------------------------------------------------------------------

# Your public address, exactly as in the browser: https, no trailing slash.
APP_URL=https://dockwell.example.com
COOKIE_SECURE=true

# Long random strings.
SECRET_KEY=change-me
ENCRYPTION_KEY=change-me

# Password for the bundled PostgreSQL (letters and digits only, it goes inside a URL).
POSTGRES_PASSWORD=change-me
# Password for Grafana's "admin" user.
GRAFANA_PASSWORD=change-me

# Platform admins: these addresses become admins when they sign in (comma separated).
ADMIN_EMAILS=you@example.com

# ---- Email (SMTP) -----------------------------------------------------------------------------
# Needed for verification, invitations, password resets and billing emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_TLS=false
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
MAIL_FROM="DockWell <no-reply@example.com>"

# ---- Model engine (keep the block for your profile) ------------------------------------------

# GPU server (--profile gpu): the model the bundled vLLM serves, registered on start-up.
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_GPU_COUNT=1
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.9
BOOTSTRAP_VLLM_URL=http://vllm:8000/v1
# Same value as VLLM_MODEL
BOOTSTRAP_VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# Same value as VLLM_MAX_MODEL_LEN
BOOTSTRAP_VLLM_CONTEXT=8192

# CPU server (--profile cpu): uncomment these instead of the block above.
# BOOTSTRAP_LLAMACPP_URL=http://llamacpp:8080/v1
# BOOTSTRAP_LLAMACPP_MODEL=qwen2.5-1.5b-instruct
# LLAMACPP_HF_REPO=Qwen/Qwen2.5-1.5B-Instruct-GGUF
# LLAMACPP_HF_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
# LLAMACPP_CONTEXT=8192

# Hugging Face read token, for gated models (Llama, Gemma...) in the bundled vLLM.
HF_TOKEN=

# ---- Deploying models from the browser ---------------------------------------------------------
# "docker" lets platform admins start vLLM / llama.cpp engines from Admin > Models.
# "none" turns it off (then you can also remove the Docker socket mount from the compose file).
ENGINE_MANAGER=docker
# Group id of the Docker socket on this server: run  stat -c %g /var/run/docker.sock
DOCKER_GID=999
VLLM_IMAGE=vllm/vllm-openai:latest
LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server

# ---- Payments (optional) -----------------------------------------------------------------------
# Stripe keys (sk_test_... for test mode, sk_live_... for live). Webhook endpoint:
# <APP_URL>/api/stripe/webhook. Leave empty to turn payments off.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Google sign-in (optional) -----------------------------------------------------------------
# Redirect URI to register in Google Cloud: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Ports on this server ----------------------------------------------------------------------
# nginx (web app + API). Put HTTPS (Caddy, nginx, Traefik) in front of it.
WEB_PORT=31080
# Prometheus and Grafana listen on 127.0.0.1 only.
PROMETHEUS_PORT=31090
PROMETHEUS_RETENTION=30d
GRAFANA_PORT=31030
# Bearer token for GET /api/metrics from outside the server (empty = private addresses only).
METRICS_TOKEN=

# ---- Behaviour (defaults are fine) ---------------------------------------------------------------
APP_NAME=DockWell
LOG_LEVEL=INFO
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=7
UPSTREAM_TIMEOUT_SECONDS=600
UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
DEFAULT_MAX_TOKENS=4096
RESERVATION_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=60
INVITATION_TTL_DAYS=7
DEMO_MODE=false
VITE_DEMO_MODE=false
